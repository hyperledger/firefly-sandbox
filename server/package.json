{
  "name": "firefly-sandbox-server",
  "version": "1.1.7",
  "description": "",
  "main": "dist/src/index.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node .",
    "start:dev": "tsnd --respawn ./src/index.ts",
    "test": "jest --verbose",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "swagger": "swagger-jsdoc -d swagger-def.json -o swagger.json src/routers/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperledger-firefly/sandbox.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/hyperledger-firefly/sandbox/issues"
  },
  "homepage": "https://github.com/hyperledger-firefly/sandbox#readme",
  "dependencies": {
    "@hyperledger/firefly-sdk": "^1.3.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "nanoid": "^6.0.1",
    "npm": "^12.0.2",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "run": "^2.0.0",
    "start": "^5.1.0",
    "strip-indent": "^4.1.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/underscore": "^1.13.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.1",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^7.0.2",
    "underscore": "^1.13.8"
  }
